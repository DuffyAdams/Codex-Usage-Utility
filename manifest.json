{
  "manifest_version": 3,
  "name": "Codex Usage Tracker",
  "version": "1.0",
  "description": "Adds a time-elapsed progress bar to the Codex usage analytics page.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/codex/cloud/settings/analytics*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
